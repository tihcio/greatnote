{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Greatnote",
  "version": "0.2.0",
  "identifier": "dev.greatnote.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Greatnote",
        "width": 1200,
        "height": 800,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    },
    "enableGTKAppId": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOEJCMDZBMTIzODk3MzUKUldRMWx6Z1NhckNMbWwvc0RvRElnSk1iT0VVeDk3b21qNi9laUM0d1dnQWdHaHNGYW1lWE1mdGIK",
      "endpoints": [
        "https://github.com/tihcio/greatnote/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Note, attività e calendario sul tuo computer",
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/greatnote.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/greatnote.desktop"
      }
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET: sincronizzazione Dropbox, calendari iCal, provider AI e
         controllo degli aggiornamenti. Le notifiche dei promemoria aggiungono
         i permessi del plugin (POST_NOTIFICATIONS e riavvio), elencati in
         docs/ANDROID_PORTING.md. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Aggiornamenti dall'app (update_commands_mobile.rs): apre
         l'installatore di sistema con l'APK della release. Android chiede
         all'utente di consentirlo la prima volta. Google Play non ammette
         questo permesso per l'aggiornamento automatico: in una build per
         lo store va tolto insieme alla funzione. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Promemoria (reminder_alarms.rs): su alcuni telefoni (vivo, Xiaomi,
         Oppo…) un'app non esente dall'ottimizzazione della batteria viene
         congelata alla chiusura e il sistema cancella le sue notifiche
         programmate. Serve a mostrare la richiesta di sistema per
         l'esenzione; l'utente decide e può revocarla. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- allowBackup="false": le note non vengono copiate nell'account Google
         dal backup automatico di Android. Il backup resta quello dell'app,
         esplicito e sotto il controllo dell'utente (docs/SECURITY.md). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.greatnote_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

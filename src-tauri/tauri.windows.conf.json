{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis", "msi"],
    "resources": {
      "resources/llama/*": "llama/"
    },
    "publisher": "Greatnote",
    "shortDescription": "Note locali, ricerca e conoscenza personale",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": ["it-IT", "en-US"]
      }
    }
  }
}

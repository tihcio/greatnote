# Registrazioni OAuth dell'editore per i calendari esterni (docs/OAUTH_SETUP.md).
# Copia questo file in `oauth.env` (escluso da git), compila i valori e
# caricalo prima di compilare:
#   set -a; source oauth.env; set +a; npm run tauri:dev
# Senza questi valori il collegamento richiede una registrazione personale
# nelle impostazioni avanzate.
GREATNOTE_GOOGLE_CLIENT_ID=
GREATNOTE_GOOGLE_CLIENT_SECRET=
GREATNOTE_MICROSOFT_CLIENT_ID=
# Sincronizzazione con Dropbox: App key dell'app registrata (nessun segreto).
GREATNOTE_DROPBOX_APP_KEY=

<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath (ADR 0028), configurazione "app": firma l'eseguibile greatnote-desktop.exe
  prima che venga incluso negli installer. Copiare questo contenuto nella
  configurazione dell'artefatto con slug "app" del progetto SignPath.
  Il nome e la versione del prodotto sono vincolati, come richiesto dalle
  condizioni di SignPath Foundation: un file con metadati diversi viene
  rifiutato.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Greatnote" product-version="${version}">
      <include path="greatnote-desktop.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
